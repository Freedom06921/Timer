{
  "name": "fullscreen-timer",
  "version": "1.0.0",
  "description": "全屏计时器 - 支持自定义UI颜色",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build",
    "pack": "vite build && electron-builder --win --x64",
    "pack:dir": "vite build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^30.5.1",
    "electron-builder": "^24.9.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.timer.fullscreen",
    "productName": "全屏计时器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer-dist/**",
      "resources/**",
      "package.json",
      "!node_modules/**",
      "!src/**",
      "!**/*.log",
      "!make-icon.js",
      "!.builder-cache/**",
      "!**/.DS_Store"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    }
  },
  "dependencies": {
    "three": "^0.187.0",
    "vue": "^3.5.44"
  }
}
